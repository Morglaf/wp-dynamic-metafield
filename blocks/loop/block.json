{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-dynamic-metafield/loop",
	"title": "SCF Field Loop",
	"category": "theme",
	"icon": "update",
	"description": "Loop over a Secure Custom Fields Repeater or Flexible Content field and render child blocks for each row.",
	"keywords": ["scf", "acf", "repeater", "flexible", "loop", "metafield"],
	"textdomain": "wp-dynamic-metafield",
	"attributes": {
		"field": {
			"type": "string",
			"default": ""
		},
		"context": {
			"type": "string",
			"default": "post"
		},
		"layout": {
			"type": "string",
			"default": ""
		},
		"userId": {
			"type": "number",
			"default": 0
		},
		"termId": {
			"type": "number",
			"default": 0
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"tagName": {
			"type": "string",
			"default": "div"
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"usesContext": ["postId", "postType", "termId", "taxonomy"]
}
